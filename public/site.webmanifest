{
  "name": "pastespot",
  "short_name": "pastespot",
  "description": "A local-only spot to paste and keep the small things.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0e1411",
  "theme_color": "#0e1411",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
